rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /incomes/{incomeId} {
      allow read: if true;
      allow create, update: if isValidId(incomeId);
      allow delete: if isValidId(incomeId);
    }

    match /expenses/{expenseId} {
      allow read: if true;
      allow create, update: if isValidId(expenseId);
      allow delete: if isValidId(expenseId);
    }

    match /participants/{participantId} {
      allow read: if true;
      allow create, update: if isValidId(participantId);
      allow delete: if isValidId(participantId);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isValidId(settingId);
      allow delete: if isValidId(settingId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
